[Desktop Entry]
Type=Application
Version=1.0
Name=SafePaste
Comment=Guard the clipboard against pasted secrets
Exec=safepaste-gui
Icon=security-high-symbolic
Terminal=false
Categories=Utility;Security;GNOME;GTK;
Keywords=clipboard;secret;security;password;credential;privacy;

# safepaste-gui (safepaste/app.py) is a background application with no
# primary window: it starts the clipboard daemon and an optional tray icon.
# Launched from this entry it also opens Preferences; the systemd user unit
# starts it at login with --background, which opens nothing. Launching it
# again while it is already running re-activates the same instance and
# simply raises Preferences instead of starting a second copy -- ordinary
# GApplication/D-Bus-activation single-instance behaviour keyed on the
# dev.safepaste.SafePaste application ID.
#
# The file name must be that ID plus .desktop. GNOME Shell looks the app up
# by it before showing any of its notifications and rejects them otherwise
# ("InvalidApp"), which GLib drops without a word; under the old name,
# safepaste.desktop, no SafePaste notification ever appeared.
